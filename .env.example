# ---------------------------------------------------------------------------
# DermaGuide / PureGlow environment configuration
# Copy to ".env" and adjust as needed.
# ---------------------------------------------------------------------------

# HTTP server
PORT=3000
NODE_ENV=development

# MongoDB (runs at localhost:27017 per deployment spec)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=dermaguide

# llama.cpp OpenAI-compatible server (runs at localhost:8080 per deployment spec)
LLAMA_BASE_URL=http://localhost:8080
LLAMA_MODEL=google/gemma-4-E4B-it-qat-q4_0-gguf:Q4_0
# Optional API key if llama.cpp was started with --api-key
LLAMA_API_KEY=
# Inactivity timeout for streamed LLM calls in ms (reset on each token).
# Raise if vision inference on CPU is slow to produce the first token.
LLAMA_TIMEOUT_MS=300000
# This model emits chain-of-thought into reasoning_content. Disabling thinking
# makes the agents answer directly (faster, and the answer isn't starved of
# tokens). Set to false only if you want the model to "think" first.
LLAMA_DISABLE_THINKING=true

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Bootstrap admin account (created on first seed if it does not exist)
ADMIN_EMAIL=admin@pureglow.shop
ADMIN_PASSWORD=ChangeMe123!
