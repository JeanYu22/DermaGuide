# ---------------------------------------------------------------------------
# DermaGuide / PureGlow environment configuration
# Copy to ".env" and adjust as needed.
# ---------------------------------------------------------------------------

# HTTP server
PORT=3000
NODE_ENV=development

# MongoDB (runs at localhost:27017 per deployment spec)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=dermaguide

# llama.cpp OpenAI-compatible server (runs at localhost:8080 per deployment spec)
LLAMA_BASE_URL=http://localhost:8080
LLAMA_MODEL=google/gemma-4-E4B-it-qat-q4_0-gguf:Q4_0
# Optional API key if llama.cpp was started with --api-key
LLAMA_API_KEY=
# Inactivity timeout for streamed LLM calls in ms (reset on each token).
# Raise if vision inference on CPU is slow to produce the first token.
LLAMA_TIMEOUT_MS=300000
# This model emits chain-of-thought into reasoning_content. Disabling thinking
# makes the agents answer directly (faster, and the answer isn't starved of
# tokens). Set to false only if you want the model to "think" first.
LLAMA_DISABLE_THINKING=true

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Bootstrap admin account (created on first seed if it does not exist)
ADMIN_EMAIL=admin@pureglow.shop
ADMIN_PASSWORD=ChangeMe123!

# --- Payments: PayPal (Smart Buttons cover PayPal + credit/debit card) ---
# Create an app at https://developer.paypal.com to get a client ID + secret.
# Leave blank to use the built-in demo (mock) checkout.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_CURRENCY=USD

# --- Dropshipping: AliExpress Dropshipping Center (Alibaba Open Platform) ---
# Register an app at https://openservice.aliexpress.com, get dropshipper
# approval, and complete OAuth to obtain an access token. Spocket & BeautyJoint
# have no public API — configure their CSV/JSON feed URL in the admin Suppliers
# tab instead.
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_ACCESS_TOKEN=
ALIEXPRESS_GATEWAY=https://api-sg.aliexpress.com/sync
